---
import { localizedPath, ui } from '../utils/locale';

export interface Props {
  title: string;
  href: string;
  area: 'area-1' | 'area-2' | 'area-3' | 'area-4';
  kicker?: string;
  description: string;
}

const { title, href, area, kicker, description } = Astro.props;
const locale = Astro.locals.starlightRoute.locale;
const t = ui(locale);
---

<a class={`area-card ${area}`} href={localizedPath(href, locale)}>
  {kicker && <span class="area-card__kicker">{t.areaLabel(kicker)}</span>}
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="area-card__action" aria-hidden="true">{t.component.explore}</span>
</a>
