---
import { localizedPath, ui } from '../utils/locale';

export interface Props {
  title: string;
  prior: string;
  outcome: string;
  steps: { label: string; href: string }[];
}

const { title, prior, outcome, steps } = Astro.props;
const locale = Astro.locals.starlightRoute.locale;
const t = ui(locale).component;
---

<section class="learning-path">
  <div>
    <p class="eyebrow">{t.learningPath}</p>
    <h3>{title}</h3>
    <p><strong>{t.priorKnowledge}</strong> {prior}</p>
    <p><strong>{t.outcome}</strong> {outcome}</p>
  </div>
  <ol>
    {steps.map((step) => (
      <li><a href={localizedPath(step.href, locale)}>{step.label}</a></li>
    ))}
  </ol>
</section>
