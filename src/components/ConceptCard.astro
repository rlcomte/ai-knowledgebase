---
export interface Props {
  title: string;
  href: string;
  description: string;
  tags?: string[];
}

const { title, href, description, tags = [] } = Astro.props;
---

<a class="concept-card" href={href}>
  <h3>{title}</h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tag-list" aria-label="Tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
</a>
