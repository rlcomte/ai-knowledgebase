---
const { entry } = Astro.locals.starlightRoute;
const hideTitle = entry.data.area === 'Home';
import StatusBadge from './StatusBadge.astro';
---

{!hideTitle && <><div class="page-meta"><StatusBadge status={entry.data.status} /><span>{Astro.locals.starlightRoute.locale === 'nl' ? 'Laatst gewijzigd' : 'Last modified'}: {entry.data.lastModified}</span></div><h1 id="_top">{entry.data.title}</h1></>}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      color: var(--sl-color-white);
      font-size: var(--sl-text-h1);
      font-weight: 650;
      line-height: var(--sl-line-height-headings);
    }
  }
</style>
